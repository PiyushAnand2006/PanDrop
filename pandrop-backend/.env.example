# --- Meta Model API ---
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_VOICE_MODEL=muse-voice-transcribe
MUSE_SPARK_MODEL=muse-spark
MUSE_WONDER_MODEL=muse-wonder
SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image

# Provider-specific endpoints (optional overrides)
FIREWORKS_API_KEY=
BASETEN_API_KEY=
SAM_API_BASE_URL=
MUSE_IMAGE_BASE_URL=

# --- Behaviour ---
USE_MOCK_AI=true
ENABLE_FALLBACK_ON_ERROR=true
USE_MOCK_MODELS=true

# --- Server ---
HOST=0.0.0.0
PORT=8000
STATIC_DIR=static
MAX_UPLOAD_MB=200
FRAME_WINDOW_SEC=1.5
CANDIDATE_FRAMES_PER_ITEM=3
